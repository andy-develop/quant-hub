+BATCH_SIZE = 60          # 与旧实现一致（实测 ~93 请求覆盖全 A）
+BATCH_RETRY = 3          # 批次整体失败的重试次数（指数退避）
+
+
+def _sym_map(secids: list[str]) -> dict[str, str]:
+    """secid(1.600004) -> 腾讯符号(sh600004) 的映射，同时保留反向索引。"""
+    out: dict[str, str] = {}
+    for secid in secids:
+        mkt, num = str(secid).split(".")
+        out[("sh" if mkt == "1" else "sz") + num] = secid
+    return out
+
+
+def _fetch_batch(s: requests.Session, batch: list[str], stats: FetchStats,
+                 smap: dict[str, str]) -> list[dict]:
+    """取一批快照。批次失败指数退避重试；重试耗尽后逐只重试一次。"""
+    last_exc: Exception | None = None
+    for attempt in range(BATCH_RETRY):
+        try:
+            r = s.get("https://qt.gtimg.cn/q=" + ",".join(batch), timeout=15)
+            r.encoding = "gbk"
+            return parse_qt_batch_response(r.text, smap, stats)
+        except Exception as e:                                  # noqa: BLE001
+            last_exc = e
+            # ★ 不再静默 continue：记账 + 指数退避（1s / 2s / 4s）
+            stats.dropped_batch_exc += 1
+            time.sleep(2 ** attempt)
+    # 重试耗尽：逐只再试一次，尽可能救回可用数据（沪市限流常是整批被拒）
+    rows: list[dict] = []
+    for sym in batch:
+        try:
+            r = s.get("https://qt.gtimg.cn/q=" + sym, timeout=15)
+            r.encoding = "gbk"
+            rows += parse_qt_batch_response(r.text, smap, stats)
+        except Exception:                                       # noqa: BLE001
+            stats.dropped_batch_exc += 1
+        time.sleep(0.15)
+    if not rows:
+        print(f"[WARN] 批次重试后仍为空({len(batch)}只): {last_exc}", flush=True)
+    return rows
+
+
+def snapshot_day(s: requests.Session, secids: list[str],
+                 day_ts: pd.Timestamp, *, universe: dict | None = None,
+                 logger=None) -> pd.DataFrame:
+    """腾讯批量快照 -> 当日OHLCV (不复权)。
+
+    ★ §0.4 修复版：所有丢弃路径均计数，不静默；结束时跑覆盖率门禁。
+    """
+    smap = _sym_map(secids)
+    stats = FetchStats(vendor="tencent-qt")
+    syms = list(smap)
+    rows: list[dict] = []
+    for i in range(0, len(syms), BATCH_SIZE):
+        rows += _fetch_batch(s, syms[i:i + BATCH_SIZE], stats, smap)
+        time.sleep(0.1)
+
+    df = pd.DataFrame(rows)
+    if not df.empty:
+        df["date"] = day_ts
+
+    print(f"[snapshot] 取到 {len(df)}/{len(secids)} 只 | "
+          f"批失败 {stats.dropped_batch_exc} 短格式 {stats.dropped_short_format} "
+          f"未知码 {stats.dropped_unknown_code} 解析失败 {stats.dropped_parse_error}",
+          flush=True)
+    if logger:
+        logger(stats)
+    return df
+
+
+def _gate_snapshot(df: pd.DataFrame, universe: dict, day_ts: pd.Timestamp) -> None:
+    """覆盖率硬门禁：<95% 黄灯告警，<80% 红灯中止（不写盘）。"""
+    res = check_stock_coverage(df["code"].tolist() if not df.empty else [],
+                               universe, day=str(day_ts.date()))
+    if res.level == "red":
+        raise RuntimeError(
+            f"[§0.4 门禁] {day_ts:%Y-%m-%d} 快照覆盖率 {res.coverage:.1%} < "
+            f"{res.fail_threshold:.0%}（沪 {res.by_market.get('sh', 0):.1%} / "
+            f"深 {res.by_market.get('sz', 0):.1%}）—— 拒绝写盘，等补跑")
+    if res.level == "warn":
+        print(f"[WARN] 快照覆盖率 {res.coverage:.1%} 低于 {res.warn_threshold:.0%}，"
+              f"沪 {res.by_market.get('sh', 0):.1%} / 深 {res.by_market.get('sz', 0):.1%}",
+              flush=True)
 
 
